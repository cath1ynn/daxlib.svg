/// Create a pill SVG compound (rounded rectangle with centered text)
/// @param {int} x – The x position of compound
/// @param {int} y – The y position of compound
/// @param {int} width – The width of the compound
/// @param {int} height – The height of the compound
/// @param {string} txt – The text to display
/// @param {string} [color] – Optional: The pill/border color
/// @param {decimal} [paddingX] – Optional horizontal padding percentage. Defaults to 0.05
/// @param {decimal} [paddingY] – Optional vertical padding percentage. Defaults to 0.02
/// @param {boolean} [wrapText] – Optional: Wrap long text onto multiple lines. Defaults to FALSE()
/// @param {int} [wrapAtChar] – Optional: Preferred wrap length. Defaults to 20
/// @param {int} [fontSize] – Optional fixed font size. Defaults to 14
/// @param {string} [textColor] – Optional text colour. Defaults to pill colour darkened by 35%
/// @returns {string} SVG Pill
function 'DaxLib.SVG.Compound.Pill' =
		(
			x: INT64,
			y: INT64,
			width: INT64,
			height: INT64,
			txt: STRING,
			color: STRING = BLANK(),
			paddingX: DOUBLE = 0.05,
			paddingY: DOUBLE = 0.02,
			wrapText: BOOLEAN = FALSE(),
			wrapAtChar: INT64 = 20,
			fontSize: INT64 = 14,
			textColor: STRING = BLANK()
		) =>
		
		VAR _PaddingX = COALESCE( paddingX, 0.05 )
		VAR _PaddingY = COALESCE( paddingY, 0.02 )
		VAR _FontSize = COALESCE( fontSize, 14 )
		VAR _WrapAtChar = MAX( 1, COALESCE( wrapAtChar, 20 ) )
		
		VAR _X = x + width * _PaddingX / 2
		VAR _Y = y + height * _PaddingY / 2
		VAR _Width = width * ( 1 - _PaddingX )
		VAR _Height = height * ( 1 - _PaddingY )
		
		VAR _Color = COALESCE( color, "#01B8AA" )
		
		// Default text colour: 35% darker than border colour
		VAR _DefaultTextColor =
			DaxLib.SVG.Color.Hex.Interpolate(
				_Color,
				"#000000",
				0.35
			)
		
		// Explicit text colour takes precedence
		VAR _TextColor =
			COALESCE(
				textColor,
				_DefaultTextColor
			)
		
		VAR _Text = TRIM( txt )
		
		
		VAR _PathText = SUBSTITUTE( _Text, " ", "|" )
		VAR _WordCount =
			IF( LEN( _Text ) > 0, PATHLENGTH( _PathText ), 0 )
		
		VAR _ShouldWrap =
			wrapText
				&& LEN( _Text ) > _WrapAtChar
				&& _WordCount > 1
		
		VAR _Candidates =
			ADDCOLUMNS(
				GENERATESERIES( 1, MAX( 1, _WordCount - 1 ) ),
				"@Length",
					VAR _N = [Value]
					RETURN
						LEN(
							CONCATENATEX(
								FILTER(
									GENERATESERIES( 1, _WordCount ),
									[Value] <= _N
								),
								PATHITEM( _PathText, [Value], TEXT ),
								" ",
								[Value], ASC
							)
						)
			)
		
		VAR _SplitAt =
			IF(
				_ShouldWrap,
				COALESCE(
					MAXX(
						FILTER( _Candidates, [@Length] <= _WrapAtChar ),
						[Value]
					),
					1
				),
				0
			)
		
		VAR _Line1 =
			IF(
				_ShouldWrap,
				CONCATENATEX(
					FILTER( GENERATESERIES( 1, _WordCount ), [Value] <= _SplitAt ),
					PATHITEM( _PathText, [Value], TEXT ),
					" ",
					[Value], ASC
				),
				_Text
			)
		
		VAR _Line2 =
			IF(
				_ShouldWrap,
				CONCATENATEX(
					FILTER( GENERATESERIES( 1, _WordCount ), [Value] > _SplitAt ),
					PATHITEM( _PathText, [Value], TEXT ),
					" ",
					[Value], ASC
				),
				BLANK()
			)
		
		VAR _Pill =
			DaxLib.SVG.Element.Rect(
				_X,
				_Y,
				_Width,
				_Height,
				_Height / 2,
				_Height / 2,
				DaxLib.SVG.Attr.Shapes(
					_Color,
					0.2,
					BLANK(),
					_Color,
					1
				)
			)
		
		VAR _TextAttr =
			DaxLib.SVG.Attr.Shapes( _TextColor ) &
			DaxLib.SVG.Attr.Txt(
				"Segoe UI",
				_FontSize,
				BLANK(),
				BLANK(),
				"middle",
				"middle"
			)
		
		VAR _CenterX = _X + _Width / 2
		VAR _CenterY = _Y + _Height / 2
		VAR _LineOffset = _FontSize * 0.65
		
		VAR _TextLine1 =
			DaxLib.SVG.Element.Txt(
				_CenterX,
				_CenterY - IF( _ShouldWrap, _LineOffset, 0 ),
				_Line1,
				0,
				0,
				_TextAttr
			)
		
		VAR _TextLine2 =
			IF(
				_ShouldWrap,
				DaxLib.SVG.Element.Txt(
					_CenterX,
					_CenterY + _LineOffset,
					_Line2,
					0,
					0,
					_TextAttr
				),
				""
			)
		
		RETURN
			IF(
				NOT ISBLANK( _Text ),
				_Pill &
				IF( _ShouldWrap, _TextLine1 & _TextLine2, _TextLine1 )
			)

	annotation DAXLIB_PackageId = __PLACEHOLDER_PACKAGE_ID__

	annotation DAXLIB_PackageVersion = __PLACEHOLDER_PACKAGE_VERSION__
